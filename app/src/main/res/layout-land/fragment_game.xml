<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:paddingTop="26dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.game_fragment.GameFragment">



   <ScrollView
       android:layout_width="match_parent"
       android:layout_height="0dp"
      android:orientation="vertical"
       android:paddingBottom="8dp"
       android:clipToPadding="false"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintBottom_toTopOf="@id/buttons_container">
      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/question_container"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">



         <include
             android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            layout="@layout/loading_item"
            app:layout_constraintTop_toTopOf="parent"/>
         <include
             android:id="@+id/header"
             android:layout_width="match_parent"
             android:layout_height="34dp"
             layout="@layout/game_header"
             app:layout_constraintTop_toTopOf="parent"/>

         <TextView
             android:id="@+id/loading_text"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
            android:text="60 Sec"
            android:textColor="@color/on_primary"
            style="@style/label.small"
            android:layout_marginTop="7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/loading"
            app:layout_constraintBottom_toBottomOf="@id/loading"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="30.dp"
                android:background="@drawable/tracking_login_background"
                app:layout_constraintTop_toTopOf="@id/header_container"
                app:strokeColor="@color/shade_quad"
                app:strokeWidth="1dp"
                android:id="@+id/question_text"
                style="@style/body.small"
                android:text="@string/fake_question"
                android:gravity="center"
                android:textColor="@color/on_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />



         <androidx.constraintlayout.widget.ConstraintLayout
             android:id="@+id/header_container"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginHorizontal="10dp"
             android:backgroundTint="#00FFFFFF"
             android:layout_marginTop="6dp"
             app:layout_constraintTop_toBottomOf="@id/loading">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/middle_guide_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintGuide_percent="0.5"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/middle_horizontal_guide_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintGuide_percent="0.44"
                app:layout_constraintStart_toStartOf="parent" />


            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/gradient_line"
                android:contentDescription="@string/first_top_gradient_line_top_design_card"
                android:rotation="180"
                app:layout_constraintEnd_toEndOf="@+id/middle_guide_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/gradient_line"
                android:gravity="end"
                android:contentDescription="@string/second_top_gradient_line_top_design_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/middle_guide_line"
                app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line" />

            <TextView
                android:id="@+id/question_number"
                style="@style/title.small"
                android:layout_width="145dp"
                android:layout_height="60dp"
                android:layout_marginVertical="8dp"
                android:background="@drawable/dialog_header_background"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:text="@string/q_1_12"
                android:textColor="@color/on_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
         </androidx.constraintlayout.widget.ConstraintLayout>


         <TextView
             android:id="@+id/option1"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginHorizontal="32dp"
             android:layout_marginTop="24.dp"
             android:background="@drawable/tracking_login_background"
             app:layout_constraintTop_toBottomOf="@id/question_text"
             app:strokeWidth="1dp"
             style="@style/body.small"
             android:padding = "12dp"
             android:text="@string/paris"
             android:gravity="center"
             android:textColor="@color/on_primary"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent" />

         <TextView
             android:id="@+id/option2"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginHorizontal="32dp"
             android:layout_marginTop="12.dp"
             android:background="@drawable/tracking_login_background"
             app:layout_constraintTop_toBottomOf="@id/option1"
             app:strokeWidth="1dp"
             style="@style/body.small"
             android:padding = "12dp"
             android:text="@string/paris"
             android:gravity="center"
             android:textColor="@color/on_primary"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent" />

         <TextView
             android:id="@+id/option3"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginHorizontal="32dp"
             android:layout_marginTop="12.dp"
             android:background="@drawable/tracking_login_background"
             app:layout_constraintTop_toBottomOf="@id/option2"
             app:strokeWidth="1dp"
             style="@style/body.small"
             android:padding = "12dp"
             android:text="@string/paris"
             android:gravity="center"
             android:textColor="@color/on_primary"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent" />

         <TextView
             android:id="@+id/option4"
             style="@style/body.small"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginHorizontal="32dp"
             android:layout_marginTop="8dp"
             android:background="@drawable/out_line_button"
             android:gravity="center"
             android:padding="12dp"
             android:text="@string/paris"
             android:textColor="@color/on_primary"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintHorizontal_bias="0.218"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintTop_toBottomOf="@id/option3"
             app:strokeWidth="1dp" />


         <ImageView
             android:id="@+id/bonus_icon1"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:src="@drawable/bonus_icon"
             android:layout_marginTop="26dp"
             android:visibility="gone"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="@id/option1"/>
         <ImageView
             android:id="@+id/bonus_icon2"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:src="@drawable/bonus_icon"
             android:layout_marginStart="71dp"
             android:visibility="gone"
             app:layout_constraintStart_toEndOf="@id/bonus_icon1"
             app:layout_constraintBottom_toTopOf="@id/bonus_icon1"/>
         <ImageView
             android:id="@+id/bonus_icon3"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:src="@drawable/bonus_icon"
             android:layout_marginEnd="71dp"
             android:layout_marginBottom="38dp"
             android:visibility="gone"
             app:layout_constraintBottom_toTopOf="@id/bonus_icon1"
             app:layout_constraintEnd_toStartOf="@id/bonus_icon1"/>

         <ImageView
             android:id="@+id/bonus_icon4"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:layout_marginBottom="73dp"
             android:src="@drawable/bonus_icon"
             android:visibility="gone"
             app:layout_constraintBottom_toTopOf="@id/bonus_icon1"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent" />
         <ImageView
             android:id="@+id/bonus_icon5"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:src="@drawable/bonus_icon"
             android:layout_marginBottom="88dp"
             android:visibility="gone"
             app:layout_constraintStart_toStartOf="@id/bonus_icon2"
             app:layout_constraintEnd_toEndOf="@id/bonus_icon2"
            app:layout_constraintBottom_toTopOf="@id/bonus_icon2"/>
         <ImageView
             android:id="@+id/bonus_icon6"
             android:layout_width="18dp"
             android:layout_height="18dp"
             android:src="@drawable/bonus_icon"
             android:layout_marginBottom="95dp"
             android:visibility="gone"
             app:layout_constraintStart_toStartOf="@id/bonus_icon3"
             app:layout_constraintEnd_toEndOf="@id/bonus_icon3"
             app:layout_constraintBottom_toTopOf="@id/bonus_icon3"/>

         <com.airbnb.lottie.LottieAnimationView
             android:id="@+id/loading_animation_icon"
             android:layout_width="150dp"
             android:layout_height="150dp"
             app:lottie_autoPlay="true"
             app:lottie_loop="true"
             android:layout_marginBottom="16dp"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintBottom_toBottomOf="parent"
             app:lottie_rawRes="@raw/loading"/>
         <TextView
             android:id="@+id/loading_animation_text"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
            android:text="@string/loading_game"
            style="@style/title.small"
            android:textColor="@color/shade_primary"
            app:layout_constraintTop_toBottomOf="@id/loading_animation_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

         <ImageView
             android:id="@+id/no_internet_image"
             android:layout_width="200dp"
             android:layout_height="148dp"
             android:src="@drawable/no_internet_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
         <TextView
             android:id="@+id/no_internet_text"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
            android:text="@string/no_connection"
            style="@style/title.small"
            android:textColor="@color/shade_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/no_internet_image"/>

         <TextView
             android:id="@+id/no_internet_description_text"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Oops! It looks like you’re offline. \n
              Please check your internet connection to continue playing"
             style="@style/body.medium"
             android:gravity="center"
             android:layout_marginTop="8dp"
             android:textColor="@color/shade_secondary"
             android:layout_marginHorizontal="24dp"
             app:layout_constraintTop_toBottomOf="@id/no_internet_text"/>
         <include
             android:id="@+id/try_agian_button"
             android:layout_width="200dp"
             android:layout_height="44dp"
             android:layout_marginTop="12dp"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toBottomOf="@id/no_internet_description_text"
             layout="@layout/primary_button"/>


      </androidx.constraintlayout.widget.ConstraintLayout>
   </ScrollView>


   <LinearLayout
      android:id="@+id/buttons_container"
       android:layout_width="match_parent"
       android:layout_height="56dp"
       android:layout_marginHorizontal="16dp"
       android:layout_marginTop="12dp"
       android:layout_marginBottom="4dp"
       android:gravity="center"
       app:layout_constraintBottom_toBottomOf="parent"
       android:orientation="horizontal">
      <TextView
          android:id="@+id/skip_button"
          android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:background="@drawable/out_line_button"
          android:layout_marginEnd="4dp"
          android:text="@string/skip"
          android:gravity="center"
          android:textColor="@color/primary"
          style="@style/label.medium"/>
      <include
          android:id="@+id/main_button"
          android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          layout="@layout/primary_button"/>

   </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>