<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="254dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/image"
        android:layout_width="190dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:src="@drawable/geography"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/button_play_now"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:src="@drawable/on_card_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Music"
        android:gravity="center"
        style="@style/title.small"
        android:layout_marginBottom="8dp"
        android:textColor="@color/on_primary"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="@id/image"
        app:layout_constraintEnd_toEndOf="@id/image"
        app:layout_constraintBottom_toTopOf="@id/button_play_now"/>
    <TextView
        android:id="@+id/play_now_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAY NOW"
        style="@style/label.medium"
        android:textColor="@color/on_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_play_now"
        app:layout_constraintBottom_toBottomOf="@id/button_play_now"/>


</androidx.constraintlayout.widget.ConstraintLayout>