<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="#020306"
    tools:context=".ui.character.CharacterFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/surface_high"
            android:layout_marginTop="30.dp"
            android:layout_marginHorizontal="16dp"
            app:strokeColor="@color/shade_quad"
            app:strokeWidth="1dp"
            style="@style/CutCornerCardView"
            app:layout_constraintTop_toTopOf="@id/header_container">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp">
                
                <ImageView
                    android:id="@+id/character_image"
                    android:layout_width="47dp"
                    android:layout_height="78dp"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/character_details_container"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/rika_image"/>

                <ImageView
                    android:id="@+id/lock_image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:rotation="-6"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/character_details_container"
                    android:src="@drawable/lock_icon"/>

                <View
                    android:id="@+id/character_details_container"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/out_line_button_small_radius"
                    app:layout_constraintBottom_toBottomOf="@+id/character_image"/>

                <TextView
                    android:id="@+id/character_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="name"
                    android:textColor="@color/shade_primary"
                    style="@style/title.medium"
                    app:layout_constraintVertical_chainStyle="packed"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toTopOf="@id/character_age"
                    app:layout_constraintStart_toStartOf="@id/character_details_container"
                    app:layout_constraintTop_toTopOf="@id/character_details_container"/>
                <TextView
                    android:id="@+id/character_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age"
                    android:textColor="@color/shade_secondary"
                    style="@style/label.x_small"
                    app:layout_constraintStart_toStartOf="@id/character_name"
                    app:layout_constraintTop_toBottomOf="@id/character_name"
                    app:layout_constraintBottom_toBottomOf="@id/character_details_container"/>


                <TextView
                    android:id="@+id/character_description"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12.dp"
                    android:layout_marginHorizontal="10dp"
                    android:text="charcter descripton "
                    style="@style/body.small"
                    android:textColor="@color/shade_secondary"
                    app:layout_constraintTop_toBottomOf="@id/character_details_container" />
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:layout_marginTop="12dp"
                   android:layout_marginBottom="24dp"
                   android:layout_marginHorizontal="8dp"
                   app:layout_constraintTop_toBottomOf="@id/character_description"
                   app:layout_constraintBottom_toBottomOf="parent">

                   <include
                       android:id="@+id/buy"
                       android:layout_width="0dp"
                       android:layout_height="44dp"
                       android:layout_weight="1"
                       layout="@layout/primary_button"
                       android:layout_marginEnd="2dp"
                       android:layout_marginStart="2dp"
                       app:layout_constraintEnd_toEndOf="@id/middle_items_guide_line"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintBottom_toBottomOf="parent"/>

                   <TextView
                       android:id="@+id/ok_button"
                       style="@style/label.medium"
                       android:layout_width="0dp"
                       android:layout_height="44dp"
                       android:layout_marginStart="2dp"
                       android:background="@drawable/out_line_button"
                       android:gravity="center"
                       android:text="@string/ok"
                       android:layout_weight="1"
                       android:textColor="@color/primary"
                       app:layout_constraintTop_toBottomOf="@+id/characters"
                       app:layout_constraintBottom_toBottomOf="parent"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="@+id/middle_items_guide_line" />

               </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFFFF"
            android:outlineAmbientShadowColor="#00FFFFFF"
            android:outlineSpotShadowColor="#00FFFFFF"
            style="@style/CutCornerCardView"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/middle_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_percent="0.5"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/middle_horizontal_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.35"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/exit_button"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/rectangle"
                    android:gravity="end|top"
                    android:paddingTop="3.5dp"
                    android:paddingHorizontal="3.5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:src="@drawable/x_icon"
                        />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@drawable/gradient_line"
                    android:layout_marginStart="12dp"
                    android:rotation="180"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/middle_guide_line"
                    app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:background="@drawable/gradient_line"

                    app:layout_constraintStart_toStartOf="@+id/middle_guide_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line"
                    />

                <TextView
                    android:id="@+id/header_title"
                    style="@style/title.small"
                    android:layout_width="145dp"
                    android:layout_height="60dp"
                    android:layout_marginVertical="8dp"
                    android:text="Character"
                    android:gravity="center"
                    android:paddingBottom="12dp"
                    android:background="@drawable/dialog_header_background"
                    android:textColor="@color/on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>