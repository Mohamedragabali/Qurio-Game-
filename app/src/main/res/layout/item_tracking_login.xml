<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="134dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:background="@drawable/tracking_login_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="16dp" />

    <ImageView
        android:id="@+id/fire"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:src="@drawable/elevation"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/background"
        app:layout_constraintStart_toStartOf="@id/background" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="70dp"
        android:src="@drawable/fire"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@id/background"
        app:layout_constraintTop_toTopOf="@id/background"
        app:layout_constraintBottom_toBottomOf="@id/background" />

    <TextView
        android:id="@+id/tracking_login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0_day_streak_start_make_a_series"
        style="@style/label.medium"
        android:textColor="@color/shade_primary"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/fire"
        app:layout_constraintTop_toTopOf="@id/background" />

    <TextView
        android:id="@+id/support_tracking_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/every_day_count"
        android:layout_marginTop="3dp"
        style="@style/label.x_small"
        android:textColor="@color/shade_secondary"
        app:layout_constraintStart_toStartOf="@id/tracking_login_text"
        app:layout_constraintTop_toBottomOf="@id/tracking_login_text" />

    <LinearLayout
        android:id="@+id/day_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/support_tracking_text"
        app:layout_constraintBottom_toBottomOf="@id/background"
        app:layout_constraintStart_toStartOf="@id/tracking_login_text">

        <include
            android:id="@+id/sun_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/mon_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/tue_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/wed_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/thu_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/fri_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />

        <include
            android:id="@+id/sat_day"
            android:layout_width="34dp"
            android:layout_height="45dp"
            layout="@layout/tracking_day_item" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>