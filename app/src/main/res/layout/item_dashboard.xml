<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:orientation="horizontal">

    <!-- start -->
    <ImageView
        android:id="@+id/first_card"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_weight="1"
        android:rotationY="180"
        android:src="@drawable/dashboard_right_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/first_guide_line"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        style="@style/label.x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lives"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="@id/first_card"
        app:layout_constraintStart_toStartOf="@id/first_card"
        app:layout_constraintTop_toTopOf="@id/first_card" />
    <TextView
        android:id="@+id/lives_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0"
        android:textColor="@color/shade_primary"
        style="@style/label.medium"
        android:layout_marginBottom="22dp"
        app:layout_constraintEnd_toEndOf="@id/first_card"
        app:layout_constraintStart_toEndOf="@id/lives_icon"
        app:layout_constraintBottom_toBottomOf="@id/first_card"/>
    <ImageView
        android:id="@+id/lives_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/heart"
        android:scaleType="centerCrop"
        android:layout_marginTop="3dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="@id/lives_count"
        app:layout_constraintBottom_toBottomOf="@id/lives_count"
        app:layout_constraintStart_toStartOf="@id/first_card"
        app:layout_constraintEnd_toStartOf="@id/lives_count"/>

    <include
        android:id="@+id/add_live_button"
        android:layout_width="18dp"
        android:layout_height="18dp"
        layout="@layout/icon_holder"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    
    <ImageView
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/plus_icon"
        app:layout_constraintStart_toStartOf="@id/add_live_button"
        app:layout_constraintEnd_toEndOf="@id/add_live_button"
        app:layout_constraintTop_toTopOf="@id/add_live_button"
        app:layout_constraintBottom_toBottomOf="@id/add_live_button"/>

    <!-- mid -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/first_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.333" />

    <ImageView
        android:id="@+id/mid_card"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:src="@drawable/dashboard_mid_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/second_guide_line"
        app:layout_constraintStart_toEndOf="@id/first_guide_line" />

    <ImageView
        android:id="@+id/crown"
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/crown"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@id/mid_card"
        app:layout_constraintStart_toStartOf="@id/mid_card"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        style="@style/label.x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/points"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="@id/mid_card"
        app:layout_constraintStart_toStartOf="@id/mid_card"
        app:layout_constraintTop_toBottomOf="@id/crown" />

    <TextView
        android:id="@+id/coins_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0"
        android:textColor="@color/shade_primary"
        style="@style/label.medium"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="@id/mid_card"
        app:layout_constraintStart_toEndOf="@id/coins_icon"
        app:layout_constraintBottom_toBottomOf="@id/mid_card"/>
    <ImageView
        android:id="@id/coins_icon"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:src="@drawable/coins"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="@id/coins_count"
        app:layout_constraintBottom_toBottomOf="@id/coins_count"
        app:layout_constraintStart_toStartOf="@id/mid_card"
        app:layout_constraintEnd_toStartOf="@id/coins_count"/>

    <!-- end -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/second_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.666" />

    <ImageView
        android:id="@+id/end_card"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_weight="1"
        android:src="@drawable/dashboard_right_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/second_guide_line" />

    <TextView
        style="@style/label.x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/awards"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="@id/end_card"
        app:layout_constraintStart_toStartOf="@id/end_card"
        app:layout_constraintTop_toTopOf="@id/end_card" />

    <TextView
        android:id="@+id/award_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0"
        android:textColor="@color/shade_primary"
        style="@style/label.medium"
        android:layout_marginBottom="22dp"
        app:layout_constraintEnd_toEndOf="@id/end_card"
        app:layout_constraintStart_toEndOf="@id/award_icon"
        app:layout_constraintBottom_toBottomOf="@id/end_card"/>
    <ImageView
        android:id="@+id/award_icon"
        android:layout_width="22dp"
        android:layout_height="20dp"
        android:src="@drawable/cup"
        android:layout_marginEnd="3dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintTop_toTopOf="@id/award_count"
        app:layout_constraintBottom_toBottomOf="@id/award_count"
        app:layout_constraintStart_toStartOf="@id/end_card"
        app:layout_constraintEnd_toStartOf="@id/award_count"/>


    <include
        android:id="@+id/show_award_button"
        android:layout_width="18dp"
        android:layout_height="18dp"
        layout="@layout/icon_holder"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/award_count"
        app:layout_constraintTop_toTopOf="@id/award_count"
        app:layout_constraintBottom_toBottomOf="@id/award_count"/>

    <ImageView
        android:id="@+id/arrow_icon"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:src="@drawable/back_icon"
        android:rotation="180"
        app:layout_constraintTop_toTopOf="@id/show_award_button"
        app:layout_constraintBottom_toBottomOf="@id/show_award_button"
        app:layout_constraintStart_toStartOf="@id/show_award_button"
        app:layout_constraintEnd_toEndOf="@id/show_award_button"/>

</androidx.constraintlayout.widget.ConstraintLayout>