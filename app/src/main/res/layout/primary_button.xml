<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginHorizontal="32dp"
    android:layout_marginTop="24dp"
    android:elevation="30dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">


    <View
        android:id="@+id/second_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/second_rectangle_with_radias"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rectangle_with_radias"
        app:layout_constraintBottom_toBottomOf="@id/second_color"
        app:layout_constraintEnd_toEndOf="@id/second_color"
        app:layout_constraintStart_toStartOf="@id/second_color"
        app:layout_constraintTop_toTopOf="@id/second_color" />

    <ImageView
        android:layout_width="50dp"
        android:layout_height="80dp"
        android:src="@drawable/primary_button_end_shadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="60dp"
        android:layout_height="16dp"
        android:alpha="0.60"
        android:src="@drawable/primary_button_bottom_shadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="47.5dp"
        android:paddingVertical="11.dp"
        android:text="@string/fake_name"
        android:textColor="@color/on_primary"
        style="@style/label.medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>