<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="10dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@color/surface"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/achievement_image"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:src="@drawable/legend"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <TextView
        android:id="@+id/achievement_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quiz Rookie"
        android:textColor="@color/shade_tertiary"
        style="@style/label.small"
        app:layout_constraintTop_toBottomOf="@id/achievement_image"
        app:layout_constraintStart_toStartOf="parent"/>

    
</androidx.constraintlayout.widget.ConstraintLayout>