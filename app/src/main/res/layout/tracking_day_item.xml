<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="28dp"
    android:background="@color/surface_high"
    android:layout_height="45dp"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/elevation"
        android:layout_width="34dp"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:alpha="0.8"
        android:visibility="visible"
        android:src="@drawable/elevation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/day_circle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/circle_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/day_char"
        style="@style/label.x_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginTop="3dp"
        android:text="@string/s"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/day_circle" />

    <ImageView
        android:id="@+id/fire_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="2dp"
        android:src="@drawable/fire"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/day_circle"
        app:layout_constraintEnd_toEndOf="@id/day_circle"
        app:layout_constraintStart_toStartOf="@id/day_circle"
        app:layout_constraintTop_toTopOf="@id/day_circle" />
</androidx.constraintlayout.widget.ConstraintLayout>