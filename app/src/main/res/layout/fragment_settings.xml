<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="#020306"
    tools:context=".ui.character.CharacterFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/surface_high"
            android:layout_marginTop="30.dp"
            android:layout_marginHorizontal="16dp"
            app:strokeColor="@color/shade_quad"
            app:strokeWidth="1dp"
            style="@style/CutCornerCardView"
            app:layout_constraintTop_toTopOf="@id/header_container">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="34dp">
                      <!--sound -->
                <ImageView
                    android:id="@+id/sound_icon"
                    android:layout_width="22dp"
                    android:layout_height="24dp"
                    android:src="@drawable/sound_icon"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound"
                    style="@style/body.small"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/shade_secondary"
                    app:layout_constraintStart_toEndOf="@id/sound_icon"
                    app:layout_constraintTop_toTopOf="@id/sound_icon"
                    app:layout_constraintBottom_toBottomOf="@id/sound_icon"/>

                <ImageView
                    android:id="@+id/out_line_sound_slider"
                    android:layout_width="170dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="22dp"
                    android:src="@drawable/out_line_setting_slider"
                    app:layout_constraintTop_toTopOf="@id/sound_icon"
                    app:layout_constraintBottom_toBottomOf="@id/sound_icon"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="16dp"
                    android:src="@drawable/full_setting_slider"
                    app:layout_constraintTop_toTopOf="@id/out_line_sound_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_sound_slider"
                    app:layout_constraintEnd_toEndOf="@id/out_line_sound_slider"
                    app:layout_constraintStart_toStartOf="@id/out_line_sound_slider"/>


                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/plus_setting_icon"
                    android:layout_marginEnd="11dp"
                    app:layout_constraintTop_toTopOf="@id/out_line_sound_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_sound_slider"
                    app:layout_constraintEnd_toEndOf="@id/out_line_sound_slider"/>

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="11dp"
                    android:src="@drawable/minus_setting_icon"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@id/out_line_sound_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_sound_slider"
                    app:layout_constraintStart_toStartOf="@id/out_line_sound_slider"/>

                <FrameLayout
                    android:id="@+id/sound_slider"
                    android:layout_width="182dp"
                    android:layout_height="32dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="start"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/sound_icon"
                    app:layout_constraintBottom_toBottomOf="@id/sound_icon">

                    <ImageView
                        android:id="@+id/sound_slider_handler"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end|center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/setting_slider_icon" />
                </FrameLayout>


                <!-- music -->
                <ImageView
                    android:id="@+id/music_icon"
                    android:layout_width="22dp"
                    android:layout_height="24dp"
                    android:src="@drawable/music_icon"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sound_icon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music"
                    style="@style/body.small"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/shade_secondary"
                    app:layout_constraintStart_toEndOf="@id/music_icon"
                    app:layout_constraintTop_toTopOf="@id/music_icon"
                    app:layout_constraintBottom_toBottomOf="@id/music_icon"/>

                <ImageView
                    android:id="@+id/out_line_music_slider"
                    android:layout_width="170dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="22dp"
                    android:src="@drawable/out_line_setting_slider"
                    app:layout_constraintTop_toTopOf="@id/music_icon"
                    app:layout_constraintBottom_toBottomOf="@id/music_icon"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="16dp"
                    android:src="@drawable/full_setting_slider"
                    app:layout_constraintTop_toTopOf="@id/out_line_music_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_music_slider"
                    app:layout_constraintEnd_toEndOf="@id/out_line_music_slider"
                    app:layout_constraintStart_toStartOf="@id/out_line_music_slider"/>

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/plus_setting_icon"
                    android:layout_marginEnd="11dp"
                    app:layout_constraintTop_toTopOf="@id/out_line_music_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_music_slider"
                    app:layout_constraintEnd_toEndOf="@id/out_line_music_slider"/>

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="11dp"
                    android:src="@drawable/minus_setting_icon"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="@id/out_line_music_slider"
                    app:layout_constraintBottom_toBottomOf="@id/out_line_music_slider"
                    app:layout_constraintStart_toStartOf="@id/out_line_music_slider"/>

                <FrameLayout
                    android:id="@+id/music_slider"
                    android:layout_width="182dp"
                    android:layout_height="32dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="start"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/music_icon"
                    app:layout_constraintBottom_toBottomOf="@id/music_icon">

                    <ImageView
                        android:id="@+id/music_slider_handler"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="start|center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/setting_slider_icon" />
                </FrameLayout>



                <ImageView
                    android:id="@+id/bottom_line"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="28dp"
                    android:src="@drawable/settings_bottom_line"
                    app:layout_constraintTop_toBottomOf="@id/music_icon"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/middle_items_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5"/>

                <TextView
                    android:id="@+id/cancel_button"
                    style="@style/label.medium"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/out_line_button"
                    android:gravity="center"
                    android:text="@string/discard"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="18dp"
                    app:layout_constraintTop_toBottomOf="@+id/bottom_line"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/middle_items_guide_line" />

                <include
                    android:id="@+id/save_changes"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    layout="@layout/primary_button"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="2dp"
                    app:layout_constraintEnd_toEndOf="@id/middle_items_guide_line"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFFFF"
            android:outlineAmbientShadowColor="#00FFFFFF"
            android:outlineSpotShadowColor="#00FFFFFF"
            style="@style/CutCornerCardView"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/middle_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_percent="0.5"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/middle_horizontal_guide_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.35"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/exit_button"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/rectangle"
                    android:gravity="end|top"
                    android:paddingTop="3.5dp"
                    android:paddingHorizontal="3.5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:src="@drawable/x_icon"
                        />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@drawable/gradient_line"
                    android:layout_marginStart="12dp"
                    android:rotation="180"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/middle_guide_line"
                    app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:background="@drawable/gradient_line"

                    app:layout_constraintStart_toStartOf="@+id/middle_guide_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/middle_horizontal_guide_line"
                    />

                <TextView
                    android:id="@+id/header_title"
                    style="@style/title.small"
                    android:layout_width="145dp"
                    android:layout_height="60dp"
                    android:layout_marginVertical="8dp"
                    android:text="@string/settings"
                    android:gravity="center"
                    android:paddingBottom="12dp"
                    android:background="@drawable/dialog_header_background"
                    android:textColor="@color/on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>