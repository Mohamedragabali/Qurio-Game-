<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="183dp"
    android:layout_height="240dp"
    android:paddingEnd="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/image"
        android:layout_width="173dp"
        android:layout_height="240dp"
        android:scaleType="centerCrop"
        android:src="@drawable/geography"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/button_background"
        android:layout_width="110dp"
        android:layout_height="30dp"
        android:scaleType="centerCrop"
        android:src="@drawable/on_card_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/type_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Music"
        style="@style/title.small"
        android:layout_marginBottom="8dp"
        android:textColor="@color/on_primary"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="@id/image"
        app:layout_constraintEnd_toEndOf="@id/image"
        app:layout_constraintBottom_toTopOf="@id/button_background"/>
    <TextView
        android:id="@+id/play_now_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAY NOW"
        style="@style/label.small"
        android:textColor="@color/on_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_background"
        app:layout_constraintBottom_toBottomOf="@id/button_background"/>


</androidx.constraintlayout.widget.ConstraintLayout>