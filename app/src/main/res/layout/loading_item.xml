<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/loading_background"
        android:layout_width="330dp"
        android:layout_height="22dp"
        android:background="@color/surface"
        android:layout_marginHorizontal="10dp"
        android:scaleType="centerCrop"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/loading"
        android:layout_width="330dp"
        android:layout_height="18dp"
        android:src="@drawable/loading_rectangle_colored"
        app:layout_constraintStart_toStartOf="@id/loading_background"
        app:layout_constraintTop_toBottomOf="@id/top_line"
        app:layout_constraintBottom_toTopOf="@id/bottom_line"
        />




    <ImageView
        android:id="@+id/top_line"
        android:layout_width="334dp"
        android:layout_height="1dp"
        android:src="@drawable/line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/loading_background"/>
    <ImageView
        android:id="@+id/bottom_line"
        android:layout_width="315dp"
        android:layout_height="1dp"
        android:src="@drawable/line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/loading_background"/>

    <View
        android:id="@+id/guid_line_first_loading"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="@id/loading"
        app:layout_constraintStart_toStartOf="@id/loading"
        android:layout_marginStart="15dp"/>

    <ImageView
        android:id="@+id/top_start_loading_icon"
        android:layout_width="24dp"
        android:layout_height="22dp"
        android:src="@drawable/top_start_loading_icon"
        android:layout_marginStart="10dp"
        android:rotation="14"
        android:rotationX="25"
        app:layout_constraintEnd_toStartOf="@+id/guid_line_first_loading"
        app:layout_constraintTop_toTopOf="@id/loading_background"/>

    <ImageView
        android:id="@+id/bottom_start_loading_icon"
        android:layout_width="15dp"
        android:layout_height="8dp"
        android:layout_marginEnd="10dp"
        android:rotation="12"
        app:layout_constraintEnd_toStartOf="@id/guid_line_first_loading"
        android:src="@drawable/bottom_start_loading_icon"
        app:layout_constraintBottom_toBottomOf="@+id/top_start_loading_icon"/>


    <View
        android:id="@+id/guid_line_end_loading"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/loading"
        app:layout_constraintEnd_toEndOf="@id/loading"
        android:layout_marginStart="15dp"/>

    <ImageView
        android:id="@+id/top_end_loading_icon"
        android:layout_width="24dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:rotation="-19"
        android:rotationX="25"
        android:src="@drawable/top_end_loading_icon"
        app:layout_constraintStart_toEndOf="@id/guid_line_end_loading"
        app:layout_constraintTop_toTopOf="@id/loading_background"
        app:layout_constraintBottom_toBottomOf="@+id/loading_background"/>

    <ImageView
        android:id="@+id/bottom_end_loading_icon"
        android:layout_width="15dp"
        android:layout_height="8dp"
        android:layout_marginStart="13dp"
        android:rotation="-16"
        android:src="@drawable/bottom_end_loading_icon"
        app:layout_constraintStart_toEndOf="@id/guid_line_end_loading"
        app:layout_constraintBottom_toBottomOf="@+id/loading_background"/>


</androidx.constraintlayout.widget.ConstraintLayout>